# CareOS-HMS Environment Configuration Template
# Copy this file to .env and fill in values for your local environment.
# Never commit .env or real credentials to version control.

# Application
APP_NAME=careos-hms-backend
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev
SWAGGER_ENABLED=true

# Backend Server (Local Native Run)
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend Server (Local Native Run)
FRONTEND_PORT=4200

# MySQL Database Configuration (Local Native Run)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careos_hms
DB_USERNAME=root
DB_PASSWORD=change_me_dev_password
DB_ROOT_PASSWORD=change_me_root_password
DB_USE_SSL=false

# Flyway Migration Configuration
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration,filesystem:../database/migrations

# Docker Compose Host Port Overrides (prevents conflicts with local MySQL or other stacks)
DOCKER_DB_PORT=3308
DOCKER_BACKEND_PORT=8081
DOCKER_FRONTEND_PORT=4201
DOCKER_MYSQL_USER=careos_app
DOCKER_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Phase 2 Security & JWT Configuration
# Generate cryptographically random >=32-byte secrets for real environments.
JWT_SECRET=change_me_minimum_32_bytes_cryptographic_jwt_signing_key
JWT_ISSUER=careos-hms
JWT_ACCESS_EXPIRATION_SECONDS=900
REFRESH_TOKEN_HMAC_SECRET=change_me_minimum_32_bytes_refresh_token_hmac_pepper
REFRESH_SESSION_EXPIRATION_SECONDS=43200
REFRESH_REMEMBER_ME_EXPIRATION_SECONDS=604800

# Authentication Cookies (use Secure=true and SameSite=None over HTTPS in production)
AUTH_REFRESH_COOKIE_NAME=careos_refresh_token
AUTH_CSRF_COOKIE_NAME=careos_csrf_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=

# Password Hashing, Brute-Force Lockout & Rate Limiting
SECURITY_BCRYPT_STRENGTH=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Initial Super-Admin Bootstrap (set true ONLY for first-time initialization; disable afterwards)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=platform.superadmin
BOOTSTRAP_ADMIN_EMAIL=superadmin@careos-hms.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_strong_bootstrap_password_123!
BOOTSTRAP_ADMIN_FIRST_NAME=Platform
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
