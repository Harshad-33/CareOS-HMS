# CareOS-HMS Environment Configuration Template
# Copy this file to .env and fill in values for your local environment.
# Never commit .env or real credentials to version control.

# Application
APP_NAME=careos-hms-backend
APP_ENV=development

# Backend Server
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend Server
FRONTEND_PORT=4200

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careos_hms
DB_USERNAME=careos_user
DB_PASSWORD=change_me_dev_password
DB_ROOT_PASSWORD=change_me_root_password
DB_USE_SSL=false

# Flyway Migration Configuration
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration,filesystem:../database/migrations
